{
    "headers": [
        {
            "source": "/robots.txt",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate"
                },
                {
                    "key": "Content-Type",
                    "value": "text/plain"
                }
            ]
        }
    ],
    "security": {
        "firewall": {
            "rules": [
                {
                    "name": "Block Stale and Fake Scraper User Agents",
                    "action": "deny",
                    "condition": {
                        "type": "or",
                        "conditions": [
                            {
                                "key": "userAgent",
                                "op": "match",
                                "value": ".*(Chrome\\/123\\.|Chrome\\/131\\.|Chrome\\/151\\.|Chrome\\/152\\.|claudebot).*$"
                            }
                        ]
                    }
                }
            ]
        }
    }
}