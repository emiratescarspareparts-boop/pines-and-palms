{
    "headers": [
        {
            "source": "/robots.txt",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate"
                },
                {
                    "key": "Content-Type",
                    "value": "text/plain"
                }
            ]
        }
    ],
    "redirects": [
        {
            "source": "/(.*)",
            "destination": "https://google.com",
            "permanent": false,
            "has": [
                {
                    "type": "header",
                    "key": "User-Agent",
                    "value": "(?i).*(Chrome/123\\.|Chrome/131\\.|Chrome/151\\.|Chrome/152\\.|claudebot).*"
                }
            ]
        }
    ]
}